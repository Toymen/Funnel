# ── Bier-Schneider Recruiting auf dem Raspberry Pi 5 (8 GB) ──────────────────
# Auf dem Pi als /opt/funnel/.env ablegen (install.sh erzeugt sie mit
# Zufalls-Secrets). Diese Datei NIE committen.

# Image aus GitHub Actions (linux/arm64). Besser eine Digest (sha256:…) statt
# „edge“ – deploy.sh setzt die Digest automatisch, wenn Docker lokal verfügbar ist.
HARLY_IMAGE=ghcr.io/toymen/funnel:edge
HARLY_VERSION=edge

# Öffentliche Adresse (HTTPS über Caddy, Profil „proxy“)
HARLY_URL=https://jobs.bier-schneider.de
HARLY_DOMAIN=jobs.bier-schneider.de
COMPOSE_PROFILES=proxy
HARLY_PORT=3000

# Datenbank
POSTGRES_USER=funnel
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=funnel

# Secrets (install.sh ersetzt __GENERATE__ durch `openssl rand -hex 32`)
BETTER_AUTH_SECRET=__GENERATE__
AI_ENCRYPTION_KEY=__GENERATE__
STORAGE_UPLOAD_SECRET=__GENERATE__
CRON_SECRET=__GENERATE__
METRICS_TOKEN=__GENERATE__
HARLY_SETUP_SECRET=__GENERATE__
HARLY_INITIAL_ADMIN_EMAIL=personal@bier-schneider.de

# Uploads lokal auf der NVMe-SSD (kein S3 nötig)
STORAGE_PROVIDER=local

# E-Mail (optional; ohne Versand funktioniert alles außer Benachrichtigungen)
RESEND_API_KEY=
EMAIL_FROM=

# ── Speicherbudget Pi 5 / 8 GB (Summe ≈ 3,2 GB, Rest für OS, Cache, optionale KI)
HARLY_APP_MEMORY=1536m
HARLY_APP_CPUS=2.0
HARLY_APP_NODE_OPTIONS=--max-old-space-size=1024
HARLY_POSTGRES_MEMORY=1024m
HARLY_POSTGRES_CPUS=1.0
HARLY_MIGRATE_MEMORY=512m
HARLY_SCHEDULER_MEMORY=256m
HARLY_SCHEDULER_CPUS=0.5
HARLY_CADDY_MEMORY=128m
HARLY_CACHE_MAX_MB=512
HARLY_CACHE_MAX_AGE_DAYS=7
HARLY_LOG_MAX_SIZE=10m
HARLY_LOG_MAX_FILES=3

# ── Backups (backup.sh) ───────────────────────────────────────────────────────
BACKUP_DIR=/opt/funnel/backups
BACKUP_KEEP_DAYS=14
# Kopie außerhalb des Pi (PRD v1 §43), z. B. NAS per SSH: user@nas:/volume1/funnel
BACKUP_REMOTE=
