# Host-Profil: Workstation / Mini-Server (amd64 oder arm64, ab 16 GB RAM)
# Summe ≈ 7 GB – großzügig für viele gleichzeitige Admins, Reports und Exporte.
HARLY_APP_MEMORY=4096m
HARLY_APP_CPUS=4.0
HARLY_APP_NODE_OPTIONS=--max-old-space-size=3072
HARLY_POSTGRES_MEMORY=2048m
HARLY_POSTGRES_CPUS=2.0
HARLY_MIGRATE_MEMORY=1024m
HARLY_SCHEDULER_MEMORY=512m
HARLY_SCHEDULER_CPUS=1.0
HARLY_CADDY_MEMORY=256m
HARLY_CACHE_MAX_MB=2048
HARLY_CACHE_MAX_AGE_DAYS=14
HARLY_LOG_MAX_SIZE=20m
HARLY_LOG_MAX_FILES=5
